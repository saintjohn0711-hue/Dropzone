# DropZone — use a NEW Supabase project named "DropZone".
# NEVER paste player1 / player1-elite keys here or into the Vercel dropzone project.

# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (inventory persist / admin). Leave blank for dry-run scrub.
SUPABASE_SERVICE_ROLE_KEY=

# —— Admin backend (/admin). DropZone Vercel only — never player1. ——
# See /cursor/stores/self/docs/admin-backend.md
# If unset, demo login admin@dropzone.test / DropZone-Admin-Demo! (labeled TEST ADMIN).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# ADMIN_ALLOWLIST=ops@example.com
# ADMIN_DISPLAY_NAME=DropZone Ops

# —— Home Depot (ToS-safe). Prefer Impact affiliate catalog feed. ——
# See /cursor/stores/self/docs/home-depot-inventory.md
HOME_DEPOT_IMPACT_FEED_URL=
HOME_DEPOT_IMPACT_USERNAME=
HOME_DEPOT_IMPACT_PASSWORD=
HOME_DEPOT_IMPACT_TOKEN=

# Alternate licensed partner REST (JSON items[])
HOME_DEPOT_API_ENDPOINT=
HOME_DEPOT_API_KEY=
# HOME_DEPOT_API_HEADER_NAME=
# HOME_DEPOT_API_HEADER_VALUE=

# Optional generic scrubber proxy (store=home-depot|lowes)
INVENTORY_SCRUBBER_ENDPOINT=
INVENTORY_SCRUBBER_API_KEY=

# —— Stripe payments (DropZone Vercel only). See docs/payments-stripe.md ——
# Demo checkout if unset. Test: sk_test_… / pk_test_…
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_APP_URL=https://dropzone-seven-ecru.vercel.app
