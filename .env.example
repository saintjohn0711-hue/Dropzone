# DropZone — use a NEW Supabase project named "DropZone".
# NEVER paste player1 / player1-elite keys here or into the Vercel dropzone project.

# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (inventory persist / admin). Leave blank for dry-run scrub.
SUPABASE_SERVICE_ROLE_KEY=

# —— Home Depot (ToS-safe). Prefer Impact affiliate catalog feed. ——
# See /cursor/stores/self/docs/home-depot-inventory.md
HOME_DEPOT_IMPACT_FEED_URL=
HOME_DEPOT_IMPACT_USERNAME=
HOME_DEPOT_IMPACT_PASSWORD=
HOME_DEPOT_IMPACT_TOKEN=

# Alternate licensed partner REST (JSON items[])
HOME_DEPOT_API_ENDPOINT=
HOME_DEPOT_API_KEY=
# HOME_DEPOT_API_HEADER_NAME=
# HOME_DEPOT_API_HEADER_VALUE=

# Optional generic scrubber proxy (store=home-depot|lowes)
INVENTORY_SCRUBBER_ENDPOINT=
INVENTORY_SCRUBBER_API_KEY=
